// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Rol {
  PROPIETARIO
  HUESPED
  INMOBILIARIA
  ASEGURADORA
  ADMIN
}

enum EstadoReporte {
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

enum EstadoKyc {
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

enum Plan {
  GRATIS
  INMOBILIARIA
  ASEGURADORA
}

enum TramoConsulta {
  GRATIS
  BASICO
  ABONO
}

model Usuario {
  id            String   @id @default(cuid())
  nombre        String
  email         String   @unique
  dni           String?  @unique
  telefono      String?
  rol           Rol
  // Nivel de permisos, independiente del rol de negocio:
  // 1 = propietario/inmobiliaria/aseguradora/huésped (piden o reciben reportes)
  // 2 = puede modificar el precio de la tabla de tarifas de consulta
  // 3 = administrador: genera claves nivel 2, da de alta cuentas sin
  //     padrón, e importa el padrón manual. También genera claves nivel 3
  //     si presenta una de las 3 claves maestras fijas de nivel 4.
  // 4 = cuentas de máxima jerarquía; conviven con las 3 claves maestras
  //     fijas en el código (no hace falta un Usuario nivel 4 para usarlas).
  nivel         Int      @default(1)
  createdAt     DateTime @default(now())

  propiedades         Propiedad[]       @relation("PropietarioPropiedades")
  reservasComoHuesped Reserva[]         @relation("HuespedReservas")
  reportesCreados     Reporte[]         @relation("ReportesCreados")
  reportesRecibidos   Reporte[]         @relation("ReportesRecibidos")
  kyc                 KycVerificacion?
  consultasRealizadas Consulta[]
  suscripcion         Suscripcion?
  claveAcceso         ClaveAcceso?      @relation("ClaveDelUsuario")
  clavesGeneradas     ClaveAcceso[]     @relation("ClavesGeneradasPor")
  padronManualCargado PadronManual[]
}

model Propiedad {
  id            String   @id @default(cuid())
  propietario   Usuario  @relation("PropietarioPropiedades", fields: [propietarioId], references: [id])
  propietarioId String
  titulo        String
  direccion     String
  ciudad        String
  tipo          String
  amueblado     Boolean  @default(true)
  createdAt     DateTime @default(now())

  reservas Reserva[]
}

model Reserva {
  id            String        @id @default(cuid())
  propiedad     Propiedad     @relation(fields: [propiedadId], references: [id])
  propiedadId   String
  huesped       Usuario       @relation("HuespedReservas", fields: [huespedId], references: [id])
  huespedId     String
  checkIn       DateTime
  checkOut      DateTime
  estado        EstadoReserva @default(CONFIRMADA)
  createdAt     DateTime      @default(now())

  reportes Reporte[]
}

model Reporte {
  id            String        @id @default(cuid())
  reserva       Reserva?      @relation(fields: [reservaId], references: [id])
  reservaId     String?
  huesped       Usuario       @relation("ReportesRecibidos", fields: [huespedId], references: [id])
  huespedId     String
  propietario   Usuario       @relation("ReportesCreados", fields: [propietarioId], references: [id])
  propietarioId String
  tipo          String
  descripcion   String
  monto         Float?
  estado        EstadoReporte @default(PENDIENTE)
  createdAt     DateTime      @default(now())
}

model KycVerificacion {
  id           String    @id @default(cuid())
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId    String    @unique
  proveedor    String    @default("manual")
  estado       EstadoKyc @default(PENDIENTE)
  verificadoEn DateTime?
  createdAt    DateTime  @default(now())
}

model Consulta {
  id             String        @id @default(cuid())
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  usuarioId      String
  huespedBuscado String
  // Posición de esta consulta entre las que hizo el mismo usuario en el mes
  // calendario en curso (1, 2, 3...), y el tramo/costo que le correspondió
  // según esa posición. Se guarda al momento de la consulta para no alterar
  // el historial si más adelante cambia el precio vigente.
  numeroEnElMes  Int
  tramo          TramoConsulta
  costoAplicado  Float
  createdAt      DateTime      @default(now())
}

model TarifaConsulta {
  id                 String        @id @default(cuid())
  tramo              TramoConsulta @unique
  desde              Int
  // null = sin límite superior (tramo ABONO)
  hasta              Int?
  precioPorConsulta  Float?
  precioAbono        Float?
  actualizadoEn      DateTime      @updatedAt
}

model ClaveAcceso {
  id            String   @id @default(cuid())
  usuario       Usuario  @relation("ClaveDelUsuario", fields: [usuarioId], references: [id])
  usuarioId     String   @unique
  // Sólo se guarda el hash; la clave en texto plano se muestra una única vez
  // al generarla y no queda persistida en ningún lado.
  claveHash     String
  // Null cuando la autorización vino de una clave maestra de nivel 4 (no
  // hay un Usuario nivel 4 puntual detrás de esas 3 claves fijas).
  generadaPor       Usuario? @relation("ClavesGeneradasPor", fields: [generadaPorId], references: [id])
  generadaPorId     String?
  generadaConClaveMaestra Boolean @default(false)
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model PadronManual {
  id             String   @id @default(cuid())
  dni            String   @unique
  nombreCompleto String
  cargadoPor     Usuario  @relation(fields: [cargadoPorId], references: [id])
  cargadoPorId   String
  createdAt      DateTime @default(now())
}

model Suscripcion {
  id                 String   @id @default(cuid())
  usuario            Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId          String   @unique
  plan               Plan     @default(GRATIS)
  consultasIncluidas Int      @default(3)
  activa             Boolean  @default(true)
  createdAt          DateTime @default(now())
}
